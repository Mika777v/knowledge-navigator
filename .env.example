# ローカル開発用の設定例。`make up` 実行時に .env が無ければこのファイルからコピーされる。
# .env は git 管理外。本番や共有環境の値をここに書かないこと。

# ---------- PostgreSQL ----------
POSTGRES_USER=knavi
POSTGRES_PASSWORD=knavi_local_only
POSTGRES_DB=knavi
# ホスト側のポート（5432 が使用中なら変更する）
POSTGRES_PORT=5432
# ビルド済みイメージを使う場合に指定（通常は変更不要）
# POSTGRES_IMAGE=knowledge-navigator/postgres:local
