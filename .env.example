# ローカル開発用の設定例。`make up` 実行時に .env が無ければこのファイルからコピーされる。
# .env は git 管理外。本番や共有環境の値をここに書かないこと。

# ---------- PostgreSQL ----------
POSTGRES_USER=knavi
POSTGRES_PASSWORD=knavi_local_only
POSTGRES_DB=knavi
# ホスト側のポート（5432 が使用中なら変更する）
POSTGRES_PORT=5432
# ビルド済みイメージを使う場合に指定（通常は変更不要）
# POSTGRES_IMAGE=knowledge-navigator/postgres:local

# ---------- 原本ファイルの置き場所（S3 互換の SeaweedFS） ----------
STORAGE_ACCESS_KEY=knavi
STORAGE_SECRET_KEY=knavi_local_only
# ホスト側のポート（8333 が使用中なら変更する）
STORAGE_PORT=8333

# ---------- ダミーデータ（make seed） ----------
# デモユーザー全員（data/README.md の一覧）に設定するパスワード。8文字以上
DEMO_USER_PASSWORD=demo-pass-2026

# ---------- backend ----------
# ホスト側のポート（8080 が使用中なら変更する）
BACKEND_PORT=8080
# 検索ログのユーザー ID を HMAC で仮名化する鍵。本番では十分に長いランダムな値にする
KNAVI_USER_HASH_SECRET=local-dev-only-change-me

# ---------- ai-service（make up-ai のときだけ） ----------
# backend と ai-service の共有のトークン。本番では十分に長いランダムな値にする
AI_SERVICE_TOKEN=local-dev-only-change-me
# Embedding のプロバイダ: ollama（既定・社外に送らない）/ openai / azure_openai（ADR-0008）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# OpenAI・Azure では EMBEDDING_MODEL に text-embedding-3-small（Azure はデプロイ名）を指定し、キーを設定する
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ---------- frontend ----------
# ホスト側のポート（3000 が使用中なら変更する）
FRONTEND_PORT=3000
